<Window x:Class="projektaplikacjamongo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:projektaplikacjamongo.ViewModels"
        Title="Mistrz Klawiatury — Typing Defender" 
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:GameViewModel />
    </Window.DataContext>

    <Window.Resources>
        <FontFamily x:Key="Mono">Consolas, Cascadia Code, Courier New</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:IndexPlusOneConverter x:Key="IndexPlusOne"/>

        <!-- ═══ Terminal Card ═══ -->
        <Style x:Key="TermCard" TargetType="Border">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- ═══ Button: Green ═══ -->
        <Style x:Key="BtnGreen" TargetType="Button">
            <Setter Property="Background" Value="#0A1A0A"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#153015"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#50FF80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#333333"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Button: Amber ═══ -->
        <Style x:Key="BtnAmber" TargetType="Button" BasedOn="{StaticResource BtnGreen}">
            <Setter Property="Foreground" Value="#FFB000"/>
            <Setter Property="BorderBrush" Value="#FFB000"/>
            <Setter Property="Background" Value="#1A1400"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2000"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFD040"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Button: Red ═══ -->
        <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource BtnGreen}">
            <Setter Property="Foreground" Value="#FF3333"/>
            <Setter Property="BorderBrush" Value="#FF3333"/>
            <Setter Property="Background" Value="#1A0A0A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A1010"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF6060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Button: Dim (secondary) ═══ -->
        <Style x:Key="BtnDim" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ TextBox ═══ -->
        <Style x:Key="TermInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="CaretBrush" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#00FF41"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Label ═══ -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ══════════════════  MENU SCREEN  ══════════════════ -->
        <Grid x:Name="MenuScreen">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentGameState}" Value="{x:Static vm:GameState.Menu}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Status bar -->
            <Border Grid.Row="0" Background="#0A0A0A" Padding="15,8" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="2" Padding="8,3" BorderThickness="1" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="#0A1A0A"/>
                                            <Setter Property="BorderBrush" Value="#00FF41"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                            <Setter Property="Background" Value="#1A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#FF3333"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="{x:Null}">
                                            <Setter Property="Background" Value="#1A1400"/>
                                            <Setter Property="BorderBrush" Value="#FFB000"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" Foreground="#AAAAAA" FontSize="11" 
                                       FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF5555" FontSize="11" 
                                   FontFamily="{StaticResource Mono}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnDim}" 
                                Command="{Binding OpenHistoryCommand}" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="[HISTORIA]" FontSize="11" FontFamily="{StaticResource Mono}"/>
                        </Button>
                        <Button Style="{StaticResource BtnDim}" 
                                Command="{Binding OpenSettingsCommand}" Padding="8,4">
                            <TextBlock Text="[USTAWIENIA]" FontSize="11" FontFamily="{StaticResource Mono}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Title + Difficulty -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,40,0,20">
                <TextBlock Text="MISTRZ KLAWIATURY" TextAlignment="Center" 
                           FontFamily="{StaticResource Mono}" FontSize="38" FontWeight="Bold" Foreground="#00FF41"
                           Margin="0,0,0,2"/>
                <TextBlock Text="────── typing defender ──────" TextAlignment="Center"
                           FontFamily="{StaticResource Mono}" FontSize="13" Foreground="#444444"/>

                <!-- Player name -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                    <TextBlock Text="login: " Foreground="#666666" FontFamily="{StaticResource Mono}" 
                               FontSize="14" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource TermInput}" Width="200" FontSize="15"/>
                </StackPanel>

                <!-- Difficulty selection -->
                <TextBlock Text="// wybierz poziom trudności" TextAlignment="Center" Foreground="#444444"
                           FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,25,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource BtnGreen}" Margin="0,0,8,0" MinWidth="140"
                            Command="{Binding StartGameCommand}" CommandParameter="easy">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" Background="#00FF41" CornerRadius="1" 
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ŁATWY" FontFamily="{StaticResource Mono}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnAmber}" Margin="0,0,8,0" MinWidth="140"
                            Command="{Binding StartGameCommand}" CommandParameter="medium">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" Background="#FFB000" CornerRadius="1" 
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ŚREDNI" FontFamily="{StaticResource Mono}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnRed}" MinWidth="140"
                            Command="{Binding StartGameCommand}" CommandParameter="hard">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" Background="#FF3333" CornerRadius="1" 
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="TRUDNY" FontFamily="{StaticResource Mono}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Bottom: Per-difficulty Rankings -->
            <Border Grid.Row="2" Style="{StaticResource TermCard}" Margin="40,0,40,25">
                <StackPanel>
                    <!-- Ranking tab buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="[ RANKING ]" FontFamily="{StaticResource Mono}" 
                                   FontSize="14" FontWeight="Bold" Foreground="#FFB000" 
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Margin="0,0,4,0" Padding="10,4" FontSize="12" Cursor="Hand"
                                Command="{Binding SwitchRankingTabCommand}" CommandParameter="easy"
                                FontFamily="{StaticResource Mono}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRankingTab}" Value="easy">
                                            <Setter Property="Background" Value="#0A1A0A"/>
                                            <Setter Property="Foreground" Value="#00FF41"/>
                                            <Setter Property="BorderBrush" Value="#00FF41"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="ŁATWY" FontFamily="{StaticResource Mono}" FontSize="11"/>
                        </Button>
                        <Button Margin="0,0,4,0" Padding="10,4" FontSize="12" Cursor="Hand"
                                Command="{Binding SwitchRankingTabCommand}" CommandParameter="medium"
                                FontFamily="{StaticResource Mono}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRankingTab}" Value="medium">
                                            <Setter Property="Background" Value="#1A1400"/>
                                            <Setter Property="Foreground" Value="#FFB000"/>
                                            <Setter Property="BorderBrush" Value="#FFB000"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="ŚREDNI" FontFamily="{StaticResource Mono}" FontSize="11"/>
                        </Button>
                        <Button Padding="10,4" FontSize="12" Cursor="Hand"
                                Command="{Binding SwitchRankingTabCommand}" CommandParameter="hard"
                                FontFamily="{StaticResource Mono}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRankingTab}" Value="hard">
                                            <Setter Property="Background" Value="#1A0A0A"/>
                                            <Setter Property="Foreground" Value="#FF3333"/>
                                            <Setter Property="BorderBrush" Value="#FF3333"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="TRUDNY" FontFamily="{StaticResource Mono}" FontSize="11"/>
                        </Button>
                    </StackPanel>

                    <!-- Header row -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" Foreground="#555555" FontSize="10" 
                                   FontFamily="{StaticResource Mono}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="GRACZ" Foreground="#555555" FontSize="10" 
                                   FontFamily="{StaticResource Mono}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="WYNIK" Foreground="#555555" FontSize="10" 
                                   FontFamily="{StaticResource Mono}" FontWeight="Bold" Margin="12,0"/>
                        <TextBlock Grid.Column="3" Text="KPM" Foreground="#555555" FontSize="10" 
                                   FontFamily="{StaticResource Mono}" FontWeight="Bold" MinWidth="55"/>
                    </Grid>
                    <Border Height="1" Background="#222222" Margin="0,0,0,4"/>

                    <!-- EASY ranking -->
                    <ItemsControl ItemsSource="{Binding TopScoresEasy}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRankingTab}" Value="easy">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="#555555" FontSize="12" FontFamily="{StaticResource Mono}"
                                               Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, 
                                               Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexPlusOne}}"/>
                                    <Button Grid.Column="1" Content="{Binding PlayerName}" 
                                            Command="{Binding DataContext.ShowPlayerRecordsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding PlayerName}"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            Foreground="#AAAAAA" Cursor="Hand" FontFamily="{StaticResource Mono}"
                                            FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="{TemplateBinding Content}" x:Name="tb"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Foreground" Value="#00FF41"/>
                                                        <Setter TargetName="tb" Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat={}{0} pkt}" 
                                               Foreground="#00FF41" FontSize="12" FontWeight="Bold" Margin="12,0"
                                               FontFamily="{StaticResource Mono}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Kpm, StringFormat={}{0:F0} kpm}" 
                                               Foreground="#666666" FontSize="11" MinWidth="55"
                                               FontFamily="{StaticResource Mono}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.AlternationCount>100</ItemsControl.AlternationCount>
                    </ItemsControl>

                    <!-- MEDIUM ranking -->
                    <ItemsControl ItemsSource="{Binding TopScoresMedium}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRankingTab}" Value="medium">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="#555555" FontSize="12" FontFamily="{StaticResource Mono}"
                                               Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, 
                                               Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexPlusOne}}"/>
                                    <Button Grid.Column="1" Content="{Binding PlayerName}" 
                                            Command="{Binding DataContext.ShowPlayerRecordsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding PlayerName}"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            Foreground="#AAAAAA" Cursor="Hand" FontFamily="{StaticResource Mono}"
                                            FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="{TemplateBinding Content}" x:Name="tb"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Foreground" Value="#00FF41"/>
                                                        <Setter TargetName="tb" Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat={}{0} pkt}" 
                                               Foreground="#FFB000" FontSize="12" FontWeight="Bold" Margin="12,0"
                                               FontFamily="{StaticResource Mono}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Kpm, StringFormat={}{0:F0} kpm}" 
                                               Foreground="#666666" FontSize="11" MinWidth="55"
                                               FontFamily="{StaticResource Mono}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.AlternationCount>100</ItemsControl.AlternationCount>
                    </ItemsControl>

                    <!-- HARD ranking -->
                    <ItemsControl ItemsSource="{Binding TopScoresHard}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRankingTab}" Value="hard">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="#555555" FontSize="12" FontFamily="{StaticResource Mono}"
                                               Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, 
                                               Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexPlusOne}}"/>
                                    <Button Grid.Column="1" Content="{Binding PlayerName}" 
                                            Command="{Binding DataContext.ShowPlayerRecordsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding PlayerName}"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            Foreground="#AAAAAA" Cursor="Hand" FontFamily="{StaticResource Mono}"
                                            FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="{TemplateBinding Content}" x:Name="tb"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Foreground" Value="#00FF41"/>
                                                        <Setter TargetName="tb" Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat={}{0} pkt}" 
                                               Foreground="#FF3333" FontSize="12" FontWeight="Bold" Margin="12,0"
                                               FontFamily="{StaticResource Mono}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Kpm, StringFormat={}{0:F0} kpm}" 
                                               Foreground="#666666" FontSize="11" MinWidth="55"
                                               FontFamily="{StaticResource Mono}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.AlternationCount>100</ItemsControl.AlternationCount>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock Text="-- brak danych --" Foreground="#333333" FontSize="11" 
                               FontFamily="{StaticResource Mono}" FontStyle="Italic" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedRankingTab}" Value="easy"/>
                                            <Condition Binding="{Binding TopScoresEasy.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedRankingTab}" Value="medium"/>
                                            <Condition Binding="{Binding TopScoresMedium.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedRankingTab}" Value="hard"/>
                                            <Condition Binding="{Binding TopScoresHard.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <Border Grid.RowSpan="3" Background="#E60D0D0D" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="ŁADOWANIE..." Foreground="#00FF41" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource Mono}"/>
            </Border>
        </Grid>

        <!-- ══════════════════  GAME SCREEN  ══════════════════ -->
        <Grid x:Name="GameScreen">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentGameState}" Value="{x:Static vm:GameState.Playing}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentGameState}" Value="{x:Static vm:GameState.Paused}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- HUD -->
            <Border Grid.Row="0" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Level -->
                    <Border Grid.Column="0" Background="#0A1A0A" BorderBrush="#00FF41" BorderThickness="1" 
                            CornerRadius="2" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentLevel, StringFormat=LVL.{0:D2}}" FontSize="13" FontWeight="Bold" 
                                   Foreground="#00FF41" FontFamily="{StaticResource Mono}"/>
                    </Border>

                    <!-- Score -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="SCORE:" FontSize="12" Foreground="#666666" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Mono}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Score}" FontSize="22" FontWeight="Bold" Foreground="#FFB000"
                                   FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Timer + KPM (center) -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GameDurationFormatted}" FontSize="18" FontWeight="Bold" 
                                   Foreground="#AAAAAA" TextAlignment="Center" FontFamily="{StaticResource Mono}"/>
                        <TextBlock Text="{Binding Kpm, StringFormat={}{0:F0} KPM}" FontSize="10" 
                                   Foreground="#00FF41" TextAlignment="Center" FontFamily="{StaticResource Mono}"/>
                    </StackPanel>

                    <!-- Destroyed / Missed -->
                    <TextBlock Grid.Column="3" Text="{Binding WordsDestroyed, StringFormat=OK:{0}}" FontSize="12" Foreground="#00FF41" 
                               VerticalAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource Mono}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding WordsMissed, StringFormat=MISS:{0}}" FontSize="12" Foreground="#FF3333" 
                               VerticalAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource Mono}" Margin="0,0,14,0"/>

                    <!-- Lives -->
                    <TextBlock Grid.Column="5" x:Name="LivesDisplay" FontSize="20" Foreground="#FF3333" VerticalAlignment="Center"
                               FontFamily="{StaticResource Mono}" Margin="0,0,10,0"/>

                    <!-- Pause button -->
                    <Button Grid.Column="6" Style="{StaticResource BtnDim}" Click="PauseButton_Click" 
                            Padding="6,3" ToolTip="Pauza (Esc)">
                        <TextBlock Text="[II]" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- GAME CANVAS -->
            <Canvas x:Name="GameCanvas" Grid.Row="1" ClipToBounds="True" Background="#0D0D0D"/>

            <!-- INPUT -->
            <Border Grid.Row="2" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&gt; " FontSize="20" Foreground="#00FF41" VerticalAlignment="Center"
                               FontFamily="{StaticResource Mono}" Margin="0,0,4,0"/>

                    <TextBox x:Name="InputTextBox" Grid.Column="1" 
                             Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource Mono}" FontSize="20" FontWeight="Bold"
                             Background="#0D0D0D" Foreground="#D4D4D4" CaretBrush="#00FF41"
                             BorderBrush="#333333" BorderThickness="1" Padding="10,6"
                             VerticalAlignment="Center" KeyDown="InputTextBox_KeyDown"
                             TextChanged="InputTextBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="2">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#00FF41"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <TextBlock Grid.Column="2" Text="ENTER ↵" Foreground="#444444" 
                               FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                               FontFamily="{StaticResource Mono}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════  PAUSE OVERLAY  ══════════════════ -->
        <Grid x:Name="PauseScreen" Panel.ZIndex="5">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentGameState}" Value="{x:Static vm:GameState.Paused}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#CC0A0A0A"/>

            <Border Width="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource TermCard}" Padding="28">
                <StackPanel>
                    <TextBlock Text="[ PAUZA ]" TextAlignment="Center" FontSize="28" FontWeight="Bold"
                               FontFamily="{StaticResource Mono}" Foreground="#FFB000" Margin="0,0,0,6"/>

                    <TextBlock TextAlignment="Center" FontSize="12" Foreground="#666666" 
                               FontFamily="{StaticResource Mono}" Margin="0,0,0,4">
                        <Run Text="SCORE: "/><Run Text="{Binding Score}" Foreground="#FFB000"/>
                    </TextBlock>
                    <TextBlock Text="{Binding GameDurationFormatted, StringFormat=CZAS: {0}}" TextAlignment="Center"
                               FontSize="12" Foreground="#666666" FontFamily="{StaticResource Mono}" Margin="0,0,0,22"/>

                    <Button Style="{StaticResource BtnGreen}" Content="KONTYNUUJ" Margin="0,0,0,8"
                            Click="ResumeGame_Click" HorizontalAlignment="Stretch"/>
                    <Button Style="{StaticResource BtnDim}" Content="WRÓĆ DO MENU" Padding="16,10" FontSize="13"
                            Click="ExitToMenu_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════  GAME OVER SCREEN  ══════════════════ -->
        <Grid x:Name="GameOverScreen">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentGameState}" Value="{x:Static vm:GameState.GameOver}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#E60A0A0A"/>

            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource TermCard}" Padding="28">
                <StackPanel>
                    <TextBlock Text="KONIEC GRY" TextAlignment="Center" FontSize="32" FontWeight="Bold"
                               FontFamily="{StaticResource Mono}" Foreground="#FF3333" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding PlayerName}" TextAlignment="Center" FontSize="13" 
                               Foreground="#666666" FontFamily="{StaticResource Mono}" Margin="0,0,0,16"/>

                    <!-- Big score -->
                    <TextBlock TextAlignment="Center" FontSize="42" FontWeight="Bold" Foreground="#FFB000"
                               FontFamily="{StaticResource Mono}" Margin="0,0,0,4">
                        <Run Text="{Binding Score}"/><Run Text=" pkt" FontSize="18" Foreground="#666666"/>
                    </TextBlock>
                    <TextBlock Text="{Binding CurrentLevel, StringFormat=Osiągnięty poziom: {0}}" TextAlignment="Center"
                               FontSize="12" Foreground="#00FF41" FontFamily="{StaticResource Mono}" Margin="0,0,0,16"/>

                    <!-- Stats -->
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <StackPanel Margin="4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Kpm, StringFormat={}{0:F0}}" FontSize="24" FontWeight="Bold" 
                                       Foreground="#00FF41" TextAlignment="Center" FontFamily="{StaticResource Mono}"/>
                            <TextBlock Text="KPM" FontSize="10" Foreground="#666666" TextAlignment="Center" FontFamily="{StaticResource Mono}"/>
                        </StackPanel>
                        <StackPanel Margin="4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding AccuracyPercent, StringFormat={}{0:F1}%}" FontSize="24" FontWeight="Bold" 
                                       Foreground="#00FF41" TextAlignment="Center" FontFamily="{StaticResource Mono}"/>
                            <TextBlock Text="CELNOŚĆ" FontSize="10" Foreground="#666666" TextAlignment="Center" FontFamily="{StaticResource Mono}"/>
                        </StackPanel>
                        <StackPanel Margin="4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding WordsDestroyed}" FontSize="24" FontWeight="Bold" 
                                       Foreground="#00FF41" TextAlignment="Center" FontFamily="{StaticResource Mono}"/>
                            <TextBlock Text="TRAFIONE" FontSize="10" Foreground="#666666" TextAlignment="Center" FontFamily="{StaticResource Mono}"/>
                        </StackPanel>
                        <StackPanel Margin="4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding WordsMissed}" FontSize="24" FontWeight="Bold" 
                                       Foreground="#FF3333" TextAlignment="Center" FontFamily="{StaticResource Mono}"/>
                            <TextBlock Text="UTRACONE" FontSize="10" Foreground="#666666" TextAlignment="Center" FontFamily="{StaticResource Mono}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{Binding GameDurationFormatted, StringFormat=czas: {0}}" TextAlignment="Center"
                               FontSize="12" Foreground="#666666" FontFamily="{StaticResource Mono}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" Margin="0,0,0,14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FF3333"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="Wynik zapisany pomyślnie!">
                                        <Setter Property="Foreground" Value="#00FF41"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource BtnGreen}" Content="JESZCZE RAZ" Margin="0,0,8,0"
                                Command="{Binding StartGameCommand}" CommandParameter="{Binding SelectedDifficulty}"/>
                        <Button Style="{StaticResource BtnDim}" Content="MENU" Padding="16,10" FontSize="14"
                                Command="{Binding BackToMenuCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════  SETTINGS SCREEN  ══════════════════ -->
        <Grid x:Name="SettingsScreen" Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentGameState}" Value="{x:Static vm:GameState.Settings}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#CC0A0A0A"/>

            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource TermCard}" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="[ USTAWIENIA ]" FontFamily="{StaticResource Mono}" 
                                   FontWeight="Bold" FontSize="18" Foreground="#AAAAAA"/>
                        <Button Content="[X]" Foreground="#666666" Background="Transparent" BorderThickness="0"
                                FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand"
                                FontFamily="{StaticResource Mono}" Command="{Binding BackFromSettingsCommand}"/>
                    </Grid>

                    <TextBlock Text="MONGODB URI" Style="{StaticResource Lbl}"/>
                    <TextBox Text="{Binding SettingConnectionString, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource TermInput}" Margin="0,0,0,12"/>

                    <TextBlock Text="BAZA DANYCH" Style="{StaticResource Lbl}"/>
                    <TextBox Text="{Binding SettingDatabaseName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource TermInput}" Margin="0,0,0,12"/>

                    <TextBlock Text="NAZWA GRACZA" Style="{StaticResource Lbl}"/>
                    <TextBox Text="{Binding SettingPlayerName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource TermInput}" Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF5555" FontSize="11" TextWrapping="Wrap"
                               FontFamily="{StaticResource Mono}" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnDim}" Content="TEST" 
                                Command="{Binding TestConnectionCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource BtnGreen}" Content="ZAPISZ" Padding="16,10"
                                Command="{Binding SaveSettingsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════  HISTORY SCREEN  ══════════════════ -->
        <Grid x:Name="HistoryScreen" Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentGameState}" Value="{x:Static vm:GameState.History}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#CC0A0A0A"/>

            <Border Width="700" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource TermCard}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="[ HISTORIA GIER ]" FontFamily="{StaticResource Mono}" 
                                   FontWeight="Bold" FontSize="18" Foreground="#AAAAAA"/>
                        <Button Content="[X]" Foreground="#666666" Background="Transparent" BorderThickness="0"
                                FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand"
                                FontFamily="{StaticResource Mono}" Command="{Binding BackFromHistoryCommand}"/>
                    </Grid>

                    <!-- Column headers -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DATA" Foreground="#555555" FontSize="10" 
                                   FontFamily="{StaticResource Mono}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="GRACZ" Foreground="#555555" FontSize="10" 
                                   FontFamily="{StaticResource Mono}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="POZIOM" Foreground="#555555" FontSize="10" 
                                   FontFamily="{StaticResource Mono}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="WYNIK" Foreground="#555555" FontSize="10" 
                                   FontFamily="{StaticResource Mono}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="4" Text="KPM" Foreground="#555555" FontSize="10" 
                                   FontFamily="{StaticResource Mono}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="5" Text="CELNOŚĆ" Foreground="#555555" FontSize="10" 
                                   FontFamily="{StaticResource Mono}" FontWeight="Bold"/>
                    </Grid>

                    <!-- Game list -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <StackPanel>
                            <Border Height="1" Background="#222222" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding RecentGames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DateFormatted}" Foreground="#666666" 
                                                       FontSize="11" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PlayerName}" Foreground="#AAAAAA" 
                                                       FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DifficultyDisplay}" FontSize="11" 
                                                       FontWeight="Bold" FontFamily="{StaticResource Mono}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#666666"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="easy">
                                                                <Setter Property="Foreground" Value="#00FF41"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="medium">
                                                                <Setter Property="Foreground" Value="#FFB000"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="hard">
                                                                <Setter Property="Foreground" Value="#FF3333"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Text="{Binding Score, StringFormat={}{0} pkt}" 
                                                       Foreground="#FFB000" FontSize="12" FontWeight="Bold"
                                                       FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Kpm, StringFormat={}{0:F0}}" 
                                                       Foreground="#00FF41" FontSize="11"
                                                       FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding AccuracyPercent, StringFormat={}{0:F0}%}" 
                                                       Foreground="#AAAAAA" FontSize="11"
                                                       FontFamily="{StaticResource Mono}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="-- brak danych --" Foreground="#333333" FontSize="11" 
                                       FontFamily="{StaticResource Mono}" FontStyle="Italic" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentGames.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Close button -->
                    <Button Grid.Row="3" Style="{StaticResource BtnDim}" Content="WRÓĆ DO MENU" 
                            Padding="16,10" FontSize="13" HorizontalAlignment="Center"
                            Command="{Binding BackFromHistoryCommand}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════  PLAYER RECORDS SCREEN  ══════════════════ -->
        <Grid x:Name="PlayerRecordsScreen" Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentGameState}" Value="{x:Static vm:GameState.Stats}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#CC0A0A0A"/>

            <Border Width="450" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource TermCard}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[ REKORDY GRACZA: " FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="16" Foreground="#AAAAAA"/>
                            <TextBlock Text="{Binding SelectedRankingPlayer}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="16" Foreground="#00FF41"/>
                            <TextBlock Text=" ]" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="16" Foreground="#AAAAAA"/>
                        </StackPanel>
                        <Button Content="[X]" Foreground="#666666" Background="Transparent" BorderThickness="0"
                                FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand"
                                FontFamily="{StaticResource Mono}" Command="{Binding BackFromStatsCommand}"/>
                    </Grid>

                    <!-- Records content -->
                    <StackPanel Grid.Row="1" Margin="0,5,0,20">
                        
                        <!-- EASY RECORD -->
                        <Border BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="POZIOM ŁATWY" Foreground="#00FF41" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Mono}" Margin="0,0,0,6"/>
                                <!-- When record exists -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EasyRecord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel>
                                        <WrapPanel Margin="0,2">
                                            <TextBlock Text="Rekord: " Foreground="#666666" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="{Binding EasyRecord.Score}" FontWeight="Bold" Foreground="#00FF41" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text=" pkt  |  KPM: " Foreground="#666666" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="{Binding EasyRecord.Kpm, StringFormat={}{0:F0}}" FontWeight="Bold" Foreground="#AAAAAA" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="  |  Celność: " Foreground="#666666" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="{Binding EasyRecord.AccuracyPercent, StringFormat={}{0:F0}%}" Foreground="#AAAAAA" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding EasyRecord.DateFormatted, StringFormat='Ustanowiono: \{0\}'}" Foreground="#666666" FontSize="11" FontFamily="{StaticResource Mono}" Margin="0,2"/>
                                    </StackPanel>
                                </Grid>
                                <!-- When record is null -->
                                <TextBlock Text="-- brak rozegranych gier --" Foreground="#444444" FontSize="12" FontFamily="{StaticResource Mono}" FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EasyRecord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- MEDIUM RECORD -->
                        <Border BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="POZIOM ŚREDNI" Foreground="#FFB000" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Mono}" Margin="0,0,0,6"/>
                                <!-- When record exists -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MediumRecord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel>
                                        <WrapPanel Margin="0,2">
                                            <TextBlock Text="Rekord: " Foreground="#666666" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="{Binding MediumRecord.Score}" FontWeight="Bold" Foreground="#FFB000" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text=" pkt  |  KPM: " Foreground="#666666" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="{Binding MediumRecord.Kpm, StringFormat={}{0:F0}}" FontWeight="Bold" Foreground="#AAAAAA" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="  |  Celność: " Foreground="#666666" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="{Binding MediumRecord.AccuracyPercent, StringFormat={}{0:F0}%}" Foreground="#AAAAAA" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding MediumRecord.DateFormatted, StringFormat='Ustanowiono: \{0\}'}" Foreground="#666666" FontSize="11" FontFamily="{StaticResource Mono}" Margin="0,2"/>
                                    </StackPanel>
                                </Grid>
                                <!-- When record is null -->
                                <TextBlock Text="-- brak rozegranych gier --" Foreground="#444444" FontSize="12" FontFamily="{StaticResource Mono}" FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MediumRecord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- HARD RECORD -->
                        <Border Padding="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="POZIOM TRUDNY" Foreground="#FF3333" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Mono}" Margin="0,0,0,6"/>
                                <!-- When record exists -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HardRecord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel>
                                        <WrapPanel Margin="0,2">
                                            <TextBlock Text="Rekord: " Foreground="#666666" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="{Binding HardRecord.Score}" FontWeight="Bold" Foreground="#FF3333" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text=" pkt  |  KPM: " Foreground="#666666" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="{Binding HardRecord.Kpm, StringFormat={}{0:F0}}" FontWeight="Bold" Foreground="#AAAAAA" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="  |  Celność: " Foreground="#666666" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="{Binding HardRecord.AccuracyPercent, StringFormat={}{0:F0}%}" Foreground="#AAAAAA" FontSize="12" FontFamily="{StaticResource Mono}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding HardRecord.DateFormatted, StringFormat='Ustanowiono: \{0\}'}" Foreground="#666666" FontSize="11" FontFamily="{StaticResource Mono}" Margin="0,2"/>
                                    </StackPanel>
                                </Grid>
                                <!-- When record is null -->
                                <TextBlock Text="-- brak rozegranych gier --" Foreground="#444444" FontSize="12" FontFamily="{StaticResource Mono}" FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HardRecord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Row="2" Style="{StaticResource BtnDim}" Content="ZAMKNIJ" 
                            Padding="16,10" FontSize="13" HorizontalAlignment="Center"
                            Command="{Binding BackFromStatsCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
